<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item android:state_pressed="true" >
        <shape android:shape="rectangle"  >
            <!-- can put this back later if ya like it <corners android:radius="20dip" /> -->
           <gradient android:angle="-90" android:startColor="#00ffee" android:endColor="#00ffee"  />
       </shape>
   </item>
   <item android:state_focused="true">
       <shape android:shape="rectangle"  >
           <!-- can put this back later if ya like it <corners android:radius="20dip" /> -->
           <solid android:color="#777777"/>
       </shape>
   </item>
   <item >
       <shape android:shape="rectangle"  >
           <!-- can put this back later if ya like it <corners android:radius="20dip" /> -->
           <!-- can put this back later if ya like it <stroke android:width="1dip" android:color="#5e7974" /> -->
            <gradient android:angle="-90" android:startColor="#00ddcc" android:endColor="#00ddcc" />
        </shape>
    </item>
</selector>