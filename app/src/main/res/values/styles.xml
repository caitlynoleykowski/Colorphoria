<resources>

    <!-- Base application theme. -->
    <style name="BaseTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorSecondary</item>
        <item name="colorPrimaryDark">@color/colorSecondaryDark</item> <!-- status bar, ... -->
        <item name="colorAccent">@color/colorSecondary</item> <!-- tab underline, progress spinner, ... -->
    </style>

    <style name="AppTheme" parent="BaseTheme"></style>

    <style name="LoggedOutTheme" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="LoggedOutTheme.Launcher">
        <item name="android:statusBarColor">@color/colorSecondary</item> <!-- status bar, ... -->
        <item name="android:windowBackground">@drawable/bg_launcher</item>
    </style>

</resources>
