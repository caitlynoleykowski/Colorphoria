<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:showDividers="middle|end"
    android:divider="@drawable/divider"
    tools:context="com.oo0o0o.colorphoria.activities.loggedinactivities.SourceActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:onClick="onCamera">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:gravity="center_vertical"
            android:padding="@dimen/activity_horizontal_margin"
            android:text="Use Camera" />

        <com.oo0o0o.colorphoria.reusableuserinterface.SquareImageButton
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/ic_camera_alt_unselected_24dp"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:onClick="onBrowse"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:gravity="center_vertical"
            android:padding="@dimen/activity_horizontal_margin"
            android:text="Select from Gallery" />
        <com.oo0o0o.colorphoria.reusableuserinterface.SquareImageButton
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/ic_collections_unselected_24dp"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:onClick="onDraw"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:gravity="center_vertical"
            android:padding="@dimen/activity_horizontal_margin"
            android:text="Draw an image" />
        <com.oo0o0o.colorphoria.reusableuserinterface.SquareImageButton
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/ic_brush_unselected_24dp"
            android:scaleType="centerCrop" />
    </LinearLayout>

</LinearLayout>
