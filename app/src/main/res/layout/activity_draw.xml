<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outer_linear_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimaryDark"
    android:orientation="vertical"
    tools:context="com.caitoo0o.filler.DrawActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/colorPrimary"
        android:elevation="@dimen/activity_vertical_margin"
        android:orientation="horizontal" >

        <ImageButton
            android:id="@+id/new_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_new_canvas_24dp"
            android:onClick="onNewButton"/>

        <ImageButton
            android:id="@+id/draw_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_brush_24dp"
            android:onClick="onDrawButton"/>

        <ImageButton
            android:id="@+id/erase_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_eraser_24dp"
            android:onClick="onEraseButton"/>

        <ImageButton
            android:id="@+id/save_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_get_app_24dp"
            android:onClick="onSaveButton"/>

        <ImageButton
            android:id="@+id/done_btn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_done_24dp"
            android:onClick="onDoneButton" />
    </LinearLayout>

    <com.caitoo0o.filler.DrawView
        android:id="@+id/drawing"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:background="#FFFFFFFF" />

    <LinearLayout
        android:id="@+id/paint_colors"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/activity_horizontal_margin"
        android:background="@color/colorPrimary"
        android:orientation="horizontal" >

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"

                android:background="#FF000000"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FF000000" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF888888"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FF888888" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFFFFFF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FFFFFFFF" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFFCCCC"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FFFFCCCC" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFF00FF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FFFF00FF" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF0000FF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FF0000FF" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF00FFFF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FF00FFFF" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF00FF00"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FF00FF00" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFFCC00"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FFFFCC00" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFF8800"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FFFF8800" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFF0000"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FFFF0000" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:background="#FF880000"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/paint_color_bg"
                android:tag="#FF880000" />

    </LinearLayout>

</LinearLayout>
