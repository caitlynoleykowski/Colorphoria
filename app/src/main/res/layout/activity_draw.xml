<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.caitoo0o.filler.activities.loggedinactivities.DrawActivity">

    <com.caitoo0o.filler.reusableuserinterface.DrawView
        android:id="@+id/drawing"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:background="#FFFFFFFF" />

    <LinearLayout
        android:id="@+id/paint_colors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:paddingTop="@dimen/medium_margin"
        android:paddingBottom="@dimen/medium_margin"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:elevation="@dimen/elevation"
        android:background="@color/colorPrimary"
        android:orientation="horizontal" >

            <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF000000"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FF000000" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF888888"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FF888888" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFFFFFF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FFFFFFFF" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFFCCCC"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FFFFCCCC" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFF00FF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FFFF00FF" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF0000FF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FF0000FF" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF00FFFF"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FF00FFFF" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FF00FF00"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FF00FF00" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFFCC00"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FFFFCC00" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFF8800"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FFFF8800" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:layout_marginRight="@dimen/small_margin"
                android:background="#FFFF0000"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FFFF0000" />

        <com.caitoo0o.filler.reusableuserinterface.SmallerSquareImageButton
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="fill_parent"
                android:background="#FF880000"
                android:onClick="onPaintColorClicked"
                android:src="@drawable/button_paint_color_bg"
                android:tag="#FF880000" />

    </LinearLayout>

    <include layout="@layout/navigation_footer" />

</LinearLayout>
