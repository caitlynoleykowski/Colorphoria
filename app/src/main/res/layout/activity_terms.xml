<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="com.oo0o0o.colorphoria.activities.loggedoutactivites.BirthdayActivity">


        <TextView
            android:id="@+id/name_prompt_text_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:gravity="center"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:textSize="20sp"
            android:breakStrategy="simple"
            android:text="@string/enter_name" />

        <EditText
            android:id="@+id/name_edit_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:hint="@string/name_placeholder"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:padding="@dimen/activity_horizontal_margin"
            android:inputType="textCapWords" />

        <TextView
            android:id="@+id/terms_agreement_text_view"
            android:paddingTop="@dimen/activity_horizontal_margin"
            android:gravity="center|top"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:textSize="14sp"
            android:breakStrategy="simple"
            android:text="@string/terms_info" />

        <TextView
            android:id="@+id/terms_continue_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/navigation_footer_height"
            android:background="@drawable/button_selector_large"
            android:text="@string/terms_continue"
            android:gravity="center"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:textColor="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:onClick="onAccept"/>
    </LinearLayout>

    <include layout="@layout/progress"></include>
</RelativeLayout>