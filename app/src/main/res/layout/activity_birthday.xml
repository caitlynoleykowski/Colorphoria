<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
xmlns:android="http://schemas.android.com/apk/res/android"
xmlns:app="http://schemas.android.com/apk/res-auto"
xmlns:tools="http://schemas.android.com/tools"
android:layout_width="match_parent"
android:layout_height="match_parent">
    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="com.oo0o0o.colorphoria.activities.loggedoutactivites.BirthdayActivity">

        <TextView
            android:id="@+id/birthday_prompt_text_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:gravity="center"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:textSize="20sp"
            android:breakStrategy="simple"
            android:text="@string/enter_birthday" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.oo0o0o.colorphoria.reusableuserinterface.ConfigurableNumberPicker
                android:id="@+id/number_picker_month"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                default_value="1"
                minimum="1"
                maximum="12"/>
            <com.oo0o0o.colorphoria.reusableuserinterface.ConfigurableNumberPicker
                android:id="@+id/number_picker_day"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                default_value="1"
                minimum="1"
                maximum="31"/>
            <com.oo0o0o.colorphoria.reusableuserinterface.ConfigurableNumberPicker
                android:id="@+id/number_picker_year"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                default_value="2000"
                minimum="1890"
                maximum="2017"/>
        </LinearLayout>

        <TextView
            android:id="@+id/birthday_text_view"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:paddingLeft="@dimen/activity_vertical_margin"
            android:paddingRight="@dimen/activity_vertical_margin"
            android:gravity="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:breakStrategy="simple"
            android:textColor="@color/colorSecondary"
            android:text="@string/birthday_placeholder" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <Button
            android:id="@+id/birthday_continue_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/birthday_continue"
            android:layout_margin="@dimen/activity_horizontal_margin"
            android:textAllCaps="false"
            android:onClick="onContinue"/>
    </LinearLayout>

    <include layout="@layout/progress">
    </include>
</RelativeLayout>
