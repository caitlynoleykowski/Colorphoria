<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.caitoo0o.filler.activities.loggedoutactivites.FillerEolActivity"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/activity_horizontal_margin">

    <android.support.v4.widget.Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <LinearLayout
        android:id="@+id/icon_linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="6"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <com.caitoo0o.filler.reusableuserinterface.SquareImageButton
            android:id="@+id/random_bleed_button"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ic_launcher_400dp"
            android:scaleType="centerCrop"
            android:clickable="false" />

    </LinearLayout>

    <android.support.v4.widget.Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>

    <TextView
        android:id="@+id/text1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:textSize="20sp"
        android:breakStrategy="simple"
        android:text="Filler has moved!" />

    <TextView
        android:id="@+id/text2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:textSize="20sp"
        android:breakStrategy="simple"
        android:text="Please download our new app to continue creating and sharing colorful images" />

    <android.support.v4.widget.Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <com.caitoo0o.filler.reusableuserinterface.ProportionalImageViewHorizontal
        android:id="@+id/colorphoria_logo_button"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:src="@drawable/img_colorphoria_logo"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:onClick="openColorphoriaOnGooglePlay"
        android:clickable="true" />

    <android.support.v4.widget.Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/colorphoria_google_play_button"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="@dimen/activity_horizontal_margin"
        android:background="@null"
        android:text="Get it on Google Play!"
        android:textAllCaps="false"
        android:textStyle="normal"
        android:onClick="openColorphoriaOnGooglePlay"
        />
    <android.support.v4.widget.Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>
</LinearLayout>