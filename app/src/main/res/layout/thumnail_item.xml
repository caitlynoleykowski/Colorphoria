<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="@dimen/activity_vertical_margin" >
    <com.oo0o0o.colorphoria.reusableuserinterface.PositionImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerInParent="true"
        tools:src="@drawable/img_test_pic_2"
        tools:scaleType="centerCrop"
        android:id="@+id/imageview"/>
    <ProgressBar
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/thumbnail_item_progress_bar"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="visible"/>
    <LinearLayout
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_centerInParent="true"
        android:id="@+id/thumbnail_item_selection_overlay"
        android:background="@color/colorSecondaryTranslucent"
        android:visibility="visible"/>
</RelativeLayout>