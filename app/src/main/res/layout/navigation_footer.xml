<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pic_source_buttons_linear_layout"
    android:layout_gravity="center"
    android:layout_width="match_parent"
    android:layout_height="@dimen/navigation_footer_height"
    android:elevation="@dimen/elevation"
    android:background="@color/colorPrimary"
    android:padding="@dimen/smallish_margin"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/drawButton"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/activity_vertical_margin"
        android:layout_weight="1"
        android:background="@drawable/my_menu_bar_button"
        android:onClick="onDraw"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_brush_dark_24dp" />

    <ImageButton
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:id="@+id/cameraButton"
        android:src="@drawable/ic_camera_alt_dark_24dp"
        android:scaleType="fitCenter"
        android:layout_marginRight="@dimen/activity_vertical_margin"
        android:background="@drawable/my_menu_bar_button"
        android:onClick="onCamera"/>

    <ImageButton
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:id="@+id/homeButton"
        android:src="@drawable/ic_home_dark_24dp"
        android:scaleType="fitCenter"
        android:layout_marginRight="@dimen/activity_vertical_margin"
        android:background="@drawable/my_menu_bar_button"
        android:onClick="onHome"/>

    <ImageButton
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:id="@+id/openExistingButton"
        android:src="@drawable/ic_collections_dark_24dp"
        android:scaleType="fitCenter"
        android:background="@drawable/my_menu_bar_button"
        android:onClick="onBrowse"/>
</LinearLayout>