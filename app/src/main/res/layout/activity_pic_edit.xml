<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.caitoo0o.filler.PicSourceActivity"
    android:background="#00cccc">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:orientation="vertical"
        android:elevation="@dimen/activity_horizontal_margin"
        android:background="#00dddd">

        <LinearLayout
            android:id="@+id/firstButtonLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onDiscard"
                android:src="@drawable/ic_delete_24dp"
                android:textStyle="bold"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onReset"
                android:src="@drawable/ic_clear_24dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:clickable="false" />

            <ImageButton
                android:id="@+id/undoButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onUndo"
                android:src="@drawable/ic_undo_24dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:clickable="false" />

            <ImageButton
                android:id="@+id/redoButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRedo"
                android:src="@drawable/ic_redo_24dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onSave"
                android:src="@drawable/ic_get_app_24dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onShare"
                android:src="@drawable/ic_share_24dp"
                android:textSize="10sp"
                android:textStyle="bold"
                android:clickable="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttonLinearLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/rotate_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRotateLeft"
                android:src="@drawable/ic_rotate_left_24dp"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRandomBleedFill"
                android:src="@drawable/filler_rbleed_icon"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onThreshold"
                android:src="@drawable/filler_threshold_icon"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRandomLineFill"
                android:src="@drawable/filler_rline_icon"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRandomFloodFill"
                android:src="@drawable/filler_rfill_icon"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <ImageButton
                android:id="@+id/rotate_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRotateRight"
                android:src="@drawable/ic_rotate_right_24dp"
                android:clickable="false" />
        </LinearLayout>
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/imageAreaLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/theImage"
            android:layout_centerInParent="true" />

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/progressBar"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:indeterminate="true"
            android:visibility="gone"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentBottom="true"
        android:background="#00dddd"
        android:orientation="horizontal"
        android:id="@+id/effect_ctrl_layout"
        android:visibility="gone">

        <ImageView
            android:id="@+id/effect_ctrl_image"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/filler_rbleed_icon"
            android:scaleType="fitCenter" />

        <SeekBar
            android:id="@+id/effect_ctrl_seekbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:layout_alignParentBottom="true"
            android:progress="50" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/effect_ctrl_apply_button"
            android:layout_alignParentBottom="true"
            android:onClick="onEffectApplyClicked"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_done_24dp" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:id="@+id/effect_ctrl_exit"
            android:layout_alignParentBottom="true"
            android:onClick="onCtrlLayoutExit"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_clear_24dp" />
    </LinearLayout>
</LinearLayout>