<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.caitoo0o.filler.activities.loggedinactivities.PicSourceActivity"
    android:background="@color/colorPrimaryDark">

    <LinearLayout
        android:id="@+id/firstButtonLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@color/colorPrimary">

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onDiscard"
            android:src="@drawable/ic_delete_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onReset"
            android:src="@drawable/ic_clear_24dp"
            android:clickable="false" />

        <ImageButton
            android:id="@+id/undoButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onUndo"
            android:src="@drawable/ic_undo_24dp"
            android:clickable="false" />

        <ImageButton
            android:id="@+id/redoButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRedo"
            android:src="@drawable/ic_redo_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onSave"
            android:src="@drawable/ic_get_app_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onShare"
            android:src="@drawable/ic_share_24dp"
            android:clickable="false" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/imageAreaLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:layout_marginLeft="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:layout_marginBottom="@dimen/activity_vertical_margin"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/theImage"
            android:layout_centerInParent="true" />

        <ProgressBar
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/progress_bar"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true"
            android:indeterminate="true"
            android:visibility="gone"/>
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:layout_alignParentBottom="true"
        android:background="@color/colorPrimary"
        android:orientation="vertical"
        android:id="@+id/effect_ctrl_layout"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/icon_linear_layout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_gravity="center"
            android:paddingRight="@dimen/activity_horizontal_margin"
            android:paddingLeft="@dimen/activity_horizontal_margin"
            android:orientation="horizontal">

            <com.caitoo0o.filler.reusableuserinterface.SquareImageButton
                android:id="@+id/icon_square_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/effect_button"
                android:onClick="onRandomBleedFill"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:padding="@dimen/image_button_border"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <com.caitoo0o.filler.reusableuserinterface.SquareImageButton
                android:id="@+id/threshold_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/effect_button"
                android:onClick="onThreshold"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:padding="@dimen/image_button_border"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <com.caitoo0o.filler.reusableuserinterface.SquareImageButton
                android:id="@+id/random_line_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/effect_button"
                android:onClick="onRandomLineFill"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:layout_marginRight="@dimen/small_margin"
                android:padding="@dimen/image_button_border"
                android:scaleType="centerCrop"
                android:clickable="false" />

            <com.caitoo0o.filler.reusableuserinterface.SquareImageButton
                android:id="@+id/random_flood_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:background="@drawable/effect_button"
                android:onClick="onRandomFloodFill"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:padding="@dimen/image_button_border"
                android:scaleType="centerCrop"
                android:clickable="false" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/choose_palette"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/my_menu_bar_button"
                android:layout_marginLeft="@dimen/activity_horizontal_margin"
                android:layout_marginRight="@dimen/activity_horizontal_margin"
                android:layout_marginBottom="@dimen/activity_horizontal_margin"
                android:layout_marginTop="@dimen/activity_horizontal_margin"
                android:scaleType="fitXY"
                android:onClick="onChoosePalette"
                android:src="@drawable/ic_chooser_24dp"
                android:clickable="false" />

            <SeekBar
                android:id="@+id/effect_ctrl_seekbar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="8"
                android:padding="@dimen/activity_vertical_margin"
                android:layout_alignParentBottom="true"
                android:progress="50" />

            <ImageButton
                android:id="@+id/rotate_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:padding="@dimen/activity_vertical_margin"
                android:background="@drawable/my_menu_bar_button"
                android:onClick="onRotateRight"
                android:src="@drawable/ic_rotate_right_24dp"
                android:clickable="false" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>