<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.oo0o0o.colorphoria.activities.loggedoutactivites.LoginActivity"
    tools:background="@color/colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical" >

    <LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        tools:context="com.oo0o0o.colorphoria.activities.loggedoutactivites.LoginActivity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/activity_horizontal_margin">

        <android.support.v4.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"/>

        <LinearLayout
            android:id="@+id/icon_linear_layout"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <com.oo0o0o.colorphoria.reusableuserinterface.ProportionalImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/img_logo"
                android:scaleType="centerCrop"
                android:layout_marginRight="@dimen/activity_vertical_margin"
                android:layout_marginLeft="@dimen/activity_vertical_margin"
                android:clickable="false" />

        </LinearLayout>

        <android.support.v4.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"/>

        <EditText
            android:id="@+id/email_edit_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:hint="@string/email_hint"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:padding="@dimen/activity_horizontal_margin"
            android:inputType="textEmailAddress" />

        <!--<android.support.design.widget.TextInputLayout-->
            <!--android:id="@+id/input_layout_password"-->
            <!--android:layout_width="match_parent"-->
            <!--android:layout_height="0dp"-->
            <!--android:layout_weight="2">-->

            <!--<EditText-->
                <!--android:id="@+id/email_edit_text"-->
                <!--android:layout_width="match_parent"-->
                <!--android:layout_height="wrap_content"-->
                <!--android:inputType="textEmailAddress"-->
                <!--android:paddingLeft="@dimen/activity_horizontal_margin"-->
                <!--android:hint="@string/email_hint" />-->
        <!--</android.support.design.widget.TextInputLayout>-->

        <EditText
            android:id="@+id/password_edit_text"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:padding="@dimen/activity_horizontal_margin"
            android:hint="@string/password_hint"
            android:inputType="textPassword"/>

        <TextView
            android:id="@+id/login_button"
            android:layout_width="fill_parent"
            android:layout_height="@dimen/navigation_footer_height"

            android:text="@string/login_button"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:gravity="center"
            android:textColor="@color/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/button_selector_large"
            android:textAllCaps="false" />

        <com.google.android.gms.common.SignInButton
            android:id="@+id/google_login_button"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginBottom="@dimen/activity_horizontal_margin" />

        <android.support.v4.widget.Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/reset_password_button_link"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/activity_horizontal_margin"
            android:background="@null"
            android:text="@string/forgot_password_button_link"
            android:textAllCaps="false"
            android:textStyle="normal"
/>
        <Button
            android:id="@+id/signup_button_link"
            android:layout_width="fill_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:text="@string/signup_button_link"
            android:textAllCaps="false"
            android:textStyle="normal"/>
    </LinearLayout>

    <include layout="@layout/progress">
    </include>
</RelativeLayout>