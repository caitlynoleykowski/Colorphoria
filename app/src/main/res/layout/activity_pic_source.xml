<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.caitoo0o.filler.PicSourceActivity">

    <LinearLayout
        android:id="@+id/firstButtonLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onDiscard"
            android:src="@drawable/ic_delete_24dp"
            android:textStyle="bold"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onReset"
            android:src="@drawable/ic_clear_24dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="false" />

        <ImageButton
            android:id="@+id/undoButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onUndo"
            android:src="@drawable/ic_undo_24dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="false" />

        <ImageButton
            android:id="@+id/redoButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRedo"
            android:src="@drawable/ic_redo_24dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onSave"
            android:src="@drawable/ic_get_app_24dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onShare"
            android:src="@drawable/ic_share_24dp"
            android:textSize="10sp"
            android:textStyle="bold"
            android:clickable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonLinearLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRotateLeft"
            android:src="@drawable/ic_rotate_left_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRandomBleedFill"
            android:src="@drawable/ic_face_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onThreshold"
            android:src="@drawable/ic_threshold_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRandomLineFill"
            android:src="@drawable/ic_line_fill_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRandomFloodFill"
            android:src="@drawable/ic_color_fill_24dp"
            android:clickable="false" />

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/my_menu_bar_button"
            android:onClick="onRotate"
            android:src="@drawable/ic_rotate_right_24dp"
            android:clickable="false" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/imageAreaLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:background="#00ccbb"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:orientation="vertical">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/theImage"
            android:layout_centerInParent="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">
            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_vertical_margin"
                android:padding="@dimen/activity_vertical_margin"
                android:id="@+id/cameraButton"
                android:src="@drawable/ic_camera_alt_200dp"
                android:scaleType="fitCenter"
                android:background="@drawable/mybutton"
                android:onClick="onCamera" />

            <ImageButton
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/openExistingButton"
                android:layout_marginTop="@dimen/activity_vertical_margin"
                android:padding="@dimen/activity_vertical_margin"
                android:src="@drawable/ic_collections_200dp"
                android:scaleType="fitCenter"
                android:background="@drawable/mybutton"
                android:onClick="onOpen"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
