<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:padding="@dimen/small_margin"
    android:orientation="vertical" >
    <ImageView
        android:id="@+id/color_spectrum_image_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:layout_marginRight="@dimen/activity_horizontal_margin"
        android:layout_marginTop="@dimen/activity_vertical_margin"
        android:padding="2dp"
        android:background="@drawable/button_effect"
        android:src="@drawable/img_color_spectrum"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/small_margin"
        android:orientation="horizontal" >
        <ImageButton
            android:id="@+id/color_selected_image_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:background="#FFFFFFFF"
            android:src="@drawable/button_paint_color_bg"/>

        <EditText
            android:id="@+id/color_selected_edit_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:padding="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:text="#FFFFFF"
            android:inputType="textNoSuggestions"
            android:cursorVisible="false"
            android:textAlignment="textEnd"
            android:textSize="20sp"
            android:textColor="@color/colorAccent"
            android:background="@color/colorPrimary"
            android:imeOptions="actionDone" />

        <ImageButton
            android:id="@+id/add_color_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/button_selector_small"
            android:src="@drawable/ic_add_24dp" />

        <ImageButton
            android:id="@+id/remove_color_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:background="@drawable/button_selector_small"
            android:src="@drawable/ic_remove_24dp" />

        </LinearLayout>

    <GridView
        android:id="@+id/color_palette_grid_view"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_margin="@dimen/activity_horizontal_margin"
        android:numColumns="8"
        android:gravity="center"
        >
        </GridView>
</LinearLayout>