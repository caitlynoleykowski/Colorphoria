<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="match_parent"
    android:background="@color/colorDark"
    android:padding="@dimen/small_margin"
    android:orientation="vertical" >
    <ImageView
        android:id="@+id/color_spectrum_image_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:paddingLeft="@dimen/activity_horizontal_margin"
        android:paddingRight="@dimen/activity_horizontal_margin"
        android:paddingTop="@dimen/activity_vertical_margin"
        android:paddingBottom="@dimen/activity_vertical_margin"
        android:src="@drawable/color_spectrum"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorDark"
        android:padding="@dimen/small_margin"
        android:orientation="horizontal" >
        <ImageButton
            android:id="@+id/color_selected_image_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:background="#FFFFFFFF"/>

        <EditText
            android:id="@+id/color_selected_edit_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:padding="@dimen/activity_horizontal_margin"
            android:layout_marginRight="@dimen/activity_horizontal_margin"
            android:text="#FFFFFF"
            android:textAlignment="textEnd"
            android:background="#FFFFFF"
            android:imeOptions="actionDone" />

        <ImageButton
            android:id="@+id/add_color_button"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="fill_parent"
            android:padding="@dimen/activity_vertical_margin"
            android:background="@drawable/my_menu_bar_button"
            android:src="@drawable/ic_done_24dp"
            android:onClick="onAddColorButton" />

        </LinearLayout>

    <LinearLayout
        android:id="@+id/selected_colors_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorDark"
        android:padding="@dimen/small_margin"
        android:orientation="horizontal" >
        </LinearLayout>
</LinearLayout>