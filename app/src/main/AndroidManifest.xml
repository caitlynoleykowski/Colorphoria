<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oo0o0o.colorphoria">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- below is redundant but useful for readabiliity/if we dont need write anymore -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera2.full"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7546412369288210~5401783923" />

        <activity
            android:name=".activities.loggedoutactivites.LoginActivity"
            android:theme="@style/LoggedOutTheme.Launcher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- <activity android:name=".activities.loggedinactivitImageFeedActivityvity"> -->
        <!-- <intent-filter> -->
        <!-- <action android:name="android.intent.action.MAIN" /> -->


        <!-- <category android:name="android.intent.category.LAUNCHER" /> -->
        <!-- </intent-filter> -->
        <!-- </activity> -->
        <activity android:name=".activities.loggedinactivities.BottomNavActivity" />
        <!-- <activity android:name=".activities.loggedoutactivites.LoginActivity" /> -->
        <activity
            android:name=".activities.loggedinactivities.SourceActivity"
            android:label="Select" />
        <activity
            android:name=".activities.loggedinactivities.PicEditActivity"
            android:label="@string/pic_edit_activity_title" />
        <activity
            android:name=".activities.loggedinactivities.CameraActivity"
            android:label="@string/camera_activity_title"/>
        <activity
            android:name=".activities.loggedinactivities.BrowseActivity"
            android:label="@string/browse_activity_title" />
        <activity
            android:name=".activities.loggedinactivities.DrawActivity"
            android:label="@string/draw_activity_title" />
        <activity
            android:name=".activities.loggedinactivities.UploadActivity"
            android:label="@string/upload_activity_title" />
        <activity
            android:name=".activities.loggedoutactivites.BirthdayActivity"
            android:theme="@style/LoggedOutTheme" />
        <activity
            android:name=".activities.loggedoutactivites.TermsActivity"
            android:theme="@style/LoggedOutTheme" />
        <activity
            android:name=".activities.loggedoutactivites.SignupActivity"
            android:theme="@style/LoggedOutTheme" />
        <activity
            android:name=".activities.loggedoutactivites.ResetPasswordActivity"
            android:theme="@style/LoggedOutTheme" />

        <service
            android:name=".backgroundtasks.MyUploadService"
            android:exported="false" />

        <provider
            android:name="android.support.v4.content.FileProvider"
            android:authorities="com.oo0o0o.colorphoria.myspecialfileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/paths" />
        </provider>

    </application>

</manifest>