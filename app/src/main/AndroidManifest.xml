<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.caitoo0o.filler">

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- below is redundant but useful for readabiliity/if we dont need write anymore -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">
        <activity android:name=".activities.LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.PicSourceActivity" />
        <activity android:name=".activities.PicEditActivity" />
        <activity android:name=".activities.BrowseActivity" />
        <activity android:name=".activities.DrawActivity" />
        <activity android:name=".activities.AccountActivity"/>
        <activity android:name=".activities.SignupActivity"/>
        <activity android:name=".activities.ResetPasswordActivity"/>
    </application>

</manifest>